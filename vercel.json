{
    "rewrites": [
        {
            "source": "/(.*)",
            "destination": "/index.html"
        }
    ],
    "headers": [
        {
            "source": "/(.*)",
            "headers": [
                {
                    "key": "Content-Security-Policy",
                    "value": "frame-ancestors *"
                }
            ]
        }
    ],
    "crons": [
        {
            "path": "/api/sync-ghl-docs",
            "schedule": "0 3 * * *"
        },
        {
            "path": "/api/embed-ghl-docs",
            "schedule": "30 3 * * *"
        }
    ]
}